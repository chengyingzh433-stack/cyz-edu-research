{
  "id": "M06",
  "criteriaDslVersion": 1,
  "title": "转换流程保持原件字节不变",
  "mapsTo": [
    "WF09"
  ],
  "executionMode": "deterministic",
  "preconditions": [
    "隔离的 M06 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "只读 PDF fixture 与转换请求"
  ],
  "actor": "CYZ scenario runner",
  "steps": [
    "转换前计算 hash",
    "执行转换或复用",
    "转换后重算 hash"
  ],
  "forbiddenBehavior": [
    {
      "id": "M06.forbid.01",
      "oracle": "不得发生：修改、重命名或删除原件",
      "condition": {
        "path": "observations.sourceMutationOperationCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M06/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "M06.pass.01",
      "oracle": "原件转换前后 SHA256 完全一致",
      "condition": {
        "path": "observations.sourceHashes",
        "operator": "unchanged",
        "expected": true
      },
      "evidenceRequired": [
        "results/M06/result.json"
      ]
    }
  ],
  "evidence": [
    "results/M06/result.json",
    "results/M06/artifacts/index.json"
  ]
}
