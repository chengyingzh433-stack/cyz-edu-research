{
  "id": "I07",
  "criteriaDslVersion": 1,
  "title": "高度相似研究触发缩小改变或淘汰",
  "mapsTo": [
    "WF03"
  ],
  "executionMode": "scripted",
  "preconditions": [
    "隔离的 I07 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "候选卡与高度相似的可核验论文"
  ],
  "actor": "CYZ scenario runner",
  "steps": [
    "比较任务和证据边界",
    "记录实质修改或淘汰",
    "保留历史与理由"
  ],
  "forbiddenBehavior": [
    {
      "id": "I07.forbid.01",
      "oracle": "不得发生：只改标题继续推荐",
      "condition": {
        "path": "observations.titleOnlyRevisionCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I07/result.json"
      ]
    },
    {
      "id": "I07.forbid.02",
      "oracle": "不得发生：删除淘汰历史",
      "condition": {
        "path": "observations.deletedHistoryEntryCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I07/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "I07.pass.01",
      "oracle": "修改或淘汰决定引用相近研究证据",
      "condition": {
        "path": "observations.candidateDisposition",
        "operator": "not_eq",
        "expected": "title_only"
      },
      "evidenceRequired": [
        "results/I07/result.json"
      ]
    },
    {
      "id": "I07.pass.02",
      "oracle": "原始观测 decisionReasonCount 必须满足 gte 1",
      "condition": {
        "path": "observations.decisionReasonCount",
        "operator": "gte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/I07/result.json"
      ]
    }
  ],
  "evidence": [
    "results/I07/result.json",
    "results/I07/artifacts/index.json"
  ],
  "sourceScenario": 7
}
