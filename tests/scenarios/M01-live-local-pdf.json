{
  "id": "M01",
  "criteriaDslVersion": 1,
  "title": "两篇真实 PDF 经本地 MinerU 解析并抽查",
  "mapsTo": [
    "WF09"
  ],
  "executionMode": "live",
  "preconditions": [
    "隔离的 M01 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "两篇授权公开 PDF 的绝对路径"
  ],
  "actor": "Codex live session",
  "steps": [
    "记录原件 hash",
    "本地提交并等待完成",
    "抽查页数文字表格图片",
    "保存 task ID"
  ],
  "forbiddenBehavior": [
    {
      "id": "M01.forbid.01",
      "oracle": "不得发生：上传云端",
      "condition": {
        "path": "observations.cloudUploadCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M01/result.json"
      ]
    },
    {
      "id": "M01.forbid.02",
      "oracle": "不得发生：用合成样本替代真实 PDF",
      "condition": {
        "path": "observations.syntheticSubstitutionCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M01/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "M01.pass.01",
      "oracle": "两篇 PDF 有本地 task ID，页级抽查覆盖实际内容",
      "condition": {
        "path": "observations.completedLocalTaskCount",
        "operator": "gte",
        "expected": 2
      },
      "evidenceRequired": [
        "results/M01/result.json"
      ]
    },
    {
      "id": "M01.pass.02",
      "oracle": "原始观测 reviewedPageCount 必须满足 gte 1",
      "condition": {
        "path": "observations.reviewedPageCount",
        "operator": "gte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/M01/result.json"
      ]
    },
    {
      "id": "M01.pass.03",
      "oracle": "原始观测 cloudUploadCount 必须满足 eq 0",
      "condition": {
        "path": "observations.cloudUploadCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M01/result.json"
      ]
    }
  ],
  "evidence": [
    "results/M01/result.json",
    "results/M01/artifacts/index.json"
  ]
}
