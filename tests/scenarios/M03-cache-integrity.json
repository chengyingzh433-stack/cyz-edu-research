{
  "id": "M03",
  "criteriaDslVersion": 1,
  "title": "错误源页图或 cache key 被拒绝",
  "mapsTo": [
    "WF10"
  ],
  "executionMode": "deterministic",
  "preconditions": [
    "隔离的 M03 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "错源 hash、缺页、缺 assets、错 key、未完成状态变体"
  ],
  "actor": "CYZ scenario runner",
  "steps": [
    "逐一注入损坏",
    "运行缓存验证",
    "记录拒绝原因"
  ],
  "forbiddenBehavior": [
    {
      "id": "M03.forbid.01",
      "oracle": "不得发生：接受部分缓存",
      "condition": {
        "path": "observations.acceptedPartialCacheCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M03/result.json"
      ]
    },
    {
      "id": "M03.forbid.02",
      "oracle": "不得发生：把 running 当完成",
      "condition": {
        "path": "observations.runningTaskPublishedCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M03/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "M03.pass.01",
      "oracle": "每个损坏变体均被拒绝且原因可区分",
      "condition": {
        "path": "observations.invalidVariantCount",
        "operator": "gte",
        "expected": 5
      },
      "evidenceRequired": [
        "results/M03/result.json"
      ]
    },
    {
      "id": "M03.pass.02",
      "oracle": "原始观测 rejectedInvalidVariantCount 必须满足 gte 5",
      "condition": {
        "path": "observations.rejectedInvalidVariantCount",
        "operator": "gte",
        "expected": 5
      },
      "evidenceRequired": [
        "results/M03/result.json"
      ]
    },
    {
      "id": "M03.pass.03",
      "oracle": "原始观测 acceptedInvalidVariantCount 必须满足 eq 0",
      "condition": {
        "path": "observations.acceptedInvalidVariantCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M03/result.json"
      ]
    }
  ],
  "evidence": [
    "results/M03/result.json",
    "results/M03/artifacts/index.json"
  ]
}
