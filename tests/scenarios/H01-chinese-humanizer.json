{
  "id": "H01",
  "criteriaDslVersion": 1,
  "title": "中文与英文分别调用指定 humanizer",
  "mapsTo": [
    "WF07"
  ],
  "executionMode": "live",
  "preconditions": [
    "隔离的 H01 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "中文段落、英文段落及两项依赖"
  ],
  "actor": "Codex live session",
  "steps": [
    "分别保存基线",
    "中文只调用 humanizer-zh",
    "英文只调用 humanizer",
    "记录输出与依赖 hash"
  ],
  "forbiddenBehavior": [
    {
      "id": "H01.forbid.01",
      "oracle": "不得发生：交叉调用错误语言依赖",
      "condition": {
        "path": "observations.wrongLanguageDependencyCallCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/H01/result.json"
      ]
    },
    {
      "id": "H01.forbid.02",
      "oracle": "不得发生：覆盖唯一基线",
      "condition": {
        "path": "observations.overwrittenBaselineCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/H01/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "H01.pass.01",
      "oracle": "中文解析到 humanizer-zh，英文解析到 humanizer",
      "condition": {
        "path": "observations.zhResolvedDependency",
        "operator": "eq",
        "expected": "humanizer-zh"
      },
      "evidenceRequired": [
        "results/H01/result.json"
      ]
    },
    {
      "id": "H01.pass.02",
      "oracle": "原始观测 enResolvedDependency 必须满足 eq \"humanizer\"",
      "condition": {
        "path": "observations.enResolvedDependency",
        "operator": "eq",
        "expected": "humanizer"
      },
      "evidenceRequired": [
        "results/H01/result.json"
      ]
    },
    {
      "id": "H01.pass.03",
      "oracle": "原始观测 preservedBaselineCount 必须满足 gte 2",
      "condition": {
        "path": "observations.preservedBaselineCount",
        "operator": "gte",
        "expected": 2
      },
      "evidenceRequired": [
        "results/H01/result.json"
      ]
    }
  ],
  "evidence": [
    "results/H01/result.json",
    "results/H01/artifacts/index.json"
  ]
}
