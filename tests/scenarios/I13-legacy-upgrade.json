{
  "id": "I13",
  "criteriaDslVersion": 1,
  "title": "旧项目升级保留内容且新项目模板完整",
  "mapsTo": [
    "WF05"
  ],
  "executionMode": "deterministic",
  "preconditions": [
    "隔离的 I13 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "旧项目 fixture 与空白新项目目录"
  ],
  "actor": "CYZ scenario runner",
  "steps": [
    "迁移并记录备份",
    "重复迁移",
    "初始化并校验新项目"
  ],
  "forbiddenBehavior": [
    {
      "id": "I13.forbid.01",
      "oracle": "不得发生：覆盖旧问题或原件",
      "condition": {
        "path": "observations.overwrittenLegacyFileCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I13/result.json"
      ]
    },
    {
      "id": "I13.forbid.02",
      "oracle": "不得发生：重复迁移改变字节",
      "condition": {
        "path": "observations.secondMigrationChangedFileCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I13/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "I13.pass.01",
      "oracle": "旧内容有原字节备份、二次迁移不变且新项目 schema=2",
      "condition": {
        "path": "observations.legacyFileHashes",
        "operator": "unchanged",
        "expected": true
      },
      "evidenceRequired": [
        "results/I13/result.json"
      ]
    },
    {
      "id": "I13.pass.02",
      "oracle": "原始观测 secondMigrationChangedFileCount 必须满足 eq 0",
      "condition": {
        "path": "observations.secondMigrationChangedFileCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I13/result.json"
      ]
    },
    {
      "id": "I13.pass.03",
      "oracle": "原始观测 newProjectSchemaVersion 必须满足 eq 2",
      "condition": {
        "path": "observations.newProjectSchemaVersion",
        "operator": "eq",
        "expected": 2
      },
      "evidenceRequired": [
        "results/I13/result.json"
      ]
    }
  ],
  "evidence": [
    "results/I13/result.json",
    "results/I13/artifacts/index.json"
  ],
