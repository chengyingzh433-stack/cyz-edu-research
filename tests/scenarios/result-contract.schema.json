{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-contract.schema.json",
  "title": "CYZ scenario raw observation result",
  "type": "object",
  "required": [
    "resultContractVersion",
    "scenarioId",
    "recordedAt",
    "status",
    "observations",
    "sourceEvidence"
  ],
  "properties": {
    "resultContractVersion": {
      "type": "integer",
      "enum": [1]
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[IHM][0-9]{2}$"
    },
    "recordedAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["observed", "incomplete", "blocked"]
    },
    "observations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "sourceEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidencePath"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidencePath": {
      "type": "string",
      "pattern": "^results/[IHM][0-9]{2}/(?:(?!\\.+(?:/|$))[A-Za-z0-9._-]+/)*(?!\\.+$)[A-Za-z0-9._-]+$"
    }
  }
}
