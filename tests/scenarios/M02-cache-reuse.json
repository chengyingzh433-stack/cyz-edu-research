{
  "id": "M02",
  "criteriaDslVersion": 1,
  "title": "同源同参数复用且不重复提交",
  "mapsTo": [
    "WF10"
  ],
  "executionMode": "live",
  "preconditions": [
    "隔离的 M02 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "M01 中一篇 PDF 的相同源与参数"
  ],
  "actor": "Codex live session",
  "steps": [
    "再次请求",
    "核对 cache key 与源任务",
    "比较提交计数"
  ],
  "forbiddenBehavior": [
    {
      "id": "M02.forbid.01",
      "oracle": "不得发生：创建第二任务",
      "condition": {
        "path": "observations.createdSecondTaskCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M02/result.json"
      ]
    },
    {
      "id": "M02.forbid.02",
      "oracle": "不得发生：丢失源任务追溯",
      "condition": {
        "path": "observations.missingSourceLineageCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M02/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "M02.pass.01",
      "oracle": "没有新增提交且复用 manifest 指向源 task ID",
      "condition": {
        "path": "observations.conversionInvocationCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M02/result.json"
      ]
    },
    {
      "id": "M02.pass.02",
      "oracle": "原始观测 submissionCountDelta 必须满足 eq 0",
      "condition": {
        "path": "observations.submissionCountDelta",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/M02/result.json"
      ]
    },
    {
      "id": "M02.pass.03",
      "oracle": "原始观测 cacheHitCount 必须满足 gte 1",
      "condition": {
        "path": "observations.cacheHitCount",
        "operator": "gte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/M02/result.json"
      ]
    },
    {
      "id": "M02.pass.04",
      "oracle": "原始观测 sourceFingerprintMatchCount 必须满足 gte 1",
      "condition": {
        "path": "observations.sourceFingerprintMatchCount",
        "operator": "gte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/M02/result.json"
      ]
    },
    {
      "id": "M02.pass.05",
      "oracle": "原始观测 parameterFingerprintMatchCount 必须满足 gte 1",
      "condition": {
        "path": "observations.parameterFingerprintMatchCount",
        "operator": "gte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/M02/result.json"
      ]
    },
    {
      "id": "M02.pass.06",
      "oracle": "原始观测 lineageTaskIdCount 必须满足 gte 1",
      "condition": {
        "path": "observations.lineageTaskIdCount",
        "operator": "gte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/M02/result.json"
      ]
    }
  ],
  "evidence": [
    "results/M02/result.json",
    "results/M02/artifacts/index.json"
  ]
}
