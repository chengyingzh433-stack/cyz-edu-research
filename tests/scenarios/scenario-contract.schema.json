{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario-contract.schema.json",
  "title": "CYZ workflow acceptance scenario",
  "type": "object",
  "required": [
    "id",
    "title",
    "mapsTo",
    "executionMode",
    "preconditions",
    "inputs",
    "actor",
    "steps",
    "forbiddenBehavior",
    "passCriteria",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[IHM][0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceScenario": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "mapsTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^WF[0-9]{2}$"
      }
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "deterministic",
        "scripted",
        "live"
      ]
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenBehavior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "passCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/predicate"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "predicate": {
      "type": "object",
      "required": [
        "predicate",
        "oracle",
        "evidenceRequired"
      ],
      "properties": {
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "oracle": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRequired": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
