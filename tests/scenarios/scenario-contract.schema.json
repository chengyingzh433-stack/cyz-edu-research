{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario-contract.schema.json",
  "title": "CYZ workflow acceptance scenario",
  "type": "object",
  "required": [
    "id",
    "title",
    "criteriaDslVersion",
    "mapsTo",
    "executionMode",
    "preconditions",
    "inputs",
    "actor",
    "steps",
    "forbiddenBehavior",
    "passCriteria",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[IHM][0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "criteriaDslVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "sourceScenario": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "mapsTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "WF01",
          "WF02",
          "WF03",
          "WF04",
          "WF05",
          "WF06",
          "WF07",
          "WF08",
          "WF09",
          "WF10",
          "WF11",
          "WF12"
        ]
      }
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "deterministic",
        "scripted",
        "live"
      ]
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenBehavior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "passCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidencePath"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidencePath": {
      "type": "string",
      "pattern": "^results/[IHM][0-9]{2}/(?:(?!\\.+(?:/|$))[A-Za-z0-9._-]+/)*(?!\\.+$)[A-Za-z0-9._-]+$"
    },
    "criterion": {
      "type": "object",
      "required": [
        "id",
        "oracle",
        "condition",
        "evidenceRequired"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[IHM][0-9]{2}\\.(?:pass|forbid)\\.[0-9]{2}$"
        },
        "oracle": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "evidenceRequired": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidencePath"
          }
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": [
        "path",
        "operator",
        "expected"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*$"
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "not_eq",
            "gte",
            "lte",
            "exists",
            "unchanged"
          ]
        },
        "expected": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "gte",
                  "lte"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "expected": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "exists",
                  "unchanged"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "expected": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    }
  }
}
