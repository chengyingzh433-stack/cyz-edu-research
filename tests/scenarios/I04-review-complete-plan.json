{
  "id": "I04",
  "criteriaDslVersion": 1,
  "title": "完整方案先审查关键缺口与替代解释",
  "mapsTo": [
    "WF02",
    "WF03"
  ],
  "executionMode": "scripted",
  "preconditions": [
    "隔离的 I04 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "结构完整但未经审查的研究方案"
  ],
  "actor": "CYZ scenario runner",
  "steps": [
    "检查主张与证据缺口",
    "记录替代解释",
    "形成继续或修改决定"
  ],
  "forbiddenBehavior": [
    {
      "id": "I04.forbid.01",
      "oracle": "不得发生：跳过审查直接写论文",
      "condition": {
        "path": "observations.prematureWritingTransitionCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I04/result.json"
      ]
    },
    {
      "id": "I04.forbid.02",
      "oracle": "不得发生：把格式完整等同研究成立",
      "condition": {
        "path": "observations.formatOnlyApprovalCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I04/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "I04.pass.01",
      "oracle": "选题卡记录替代解释与失败条件",
      "condition": {
        "path": "observations.counterExplanationCount",
        "operator": "gte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/I04/result.json"
      ]
    },
    {
      "id": "I04.pass.02",
      "oracle": "原始观测 failureConditionCount 必须满足 gte 1",
      "condition": {
        "path": "observations.failureConditionCount",
        "operator": "gte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/I04/result.json"
      ]
    }
  ],
  "evidence": [
    "results/I04/result.json",
    "results/I04/artifacts/index.json"
  ],
  "sourceScenario": 4
}
