{
  "id": "I02",
  "criteriaDslVersion": 1,
  "title": "模糊领域加种子论文时先盘点复用再补覆盖",
  "mapsTo": [
    "WF01"
  ],
  "executionMode": "live",
  "preconditions": [
    "隔离的 I02 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "模糊领域描述与一批公开可读种子论文"
  ],
  "actor": "Codex live session",
  "steps": [
    "盘点去重并复用种子材料",
    "识别覆盖偏差",
    "仅补查未覆盖方向"
  ],
  "forbiddenBehavior": [
    {
      "id": "I02.forbid.01",
      "oracle": "不得发生：重复询问文献已有信息",
      "condition": {
        "path": "observations.repeatedKnownQuestionCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I02/result.json"
      ]
    },
    {
      "id": "I02.forbid.02",
      "oracle": "不得发生：机械凑候选数量",
      "condition": {
        "path": "observations.unsupportedCandidatePaddingCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I02/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "I02.pass.01",
      "oracle": "检索记录引用既有 paper_id 并说明补查范围与停止条件",
      "condition": {
        "path": "observations.seedMaterialReuseCount",
        "operator": "gte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/I02/result.json"
      ]
    },
    {
      "id": "I02.pass.02",
      "oracle": "原始观测 duplicateConversionCount 必须满足 eq 0",
      "condition": {
        "path": "observations.duplicateConversionCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I02/result.json"
      ]
    },
    {
      "id": "I02.pass.03",
      "oracle": "原始观测 supplementSearchStopCondition 必须满足 not_eq \"\"",
      "condition": {
        "path": "observations.supplementSearchStopCondition",
        "operator": "not_eq",
        "expected": ""
      },
      "evidenceRequired": [
        "results/I02/result.json"
      ]
    }
  ],
  "evidence": [
    "results/I02/result.json",
    "results/I02/artifacts/index.json"
  ],
  "sourceScenario": 2
}
