{
  "id": "I03",
  "criteriaDslVersion": 1,
  "title": "模糊 idea 直接澄清并定向定位",
  "mapsTo": [
    "WF02",
    "WF03"
  ],
  "executionMode": "live",
  "preconditions": [
    "隔离的 I03 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "用户仅提供“AI 辅助实验教学”"
  ],
  "actor": "Codex live session",
  "steps": [
    "判定成熟度",
    "每轮追问一个关键边界",
    "定向寻找相近研究"
  ],
  "forbiddenBehavior": [
    {
      "id": "I03.forbid.01",
      "oracle": "不得发生：重扫整个学科",
      "condition": {
        "path": "observations.wholeDisciplineRescanCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I03/result.json"
      ]
    },
    {
      "id": "I03.forbid.02",
      "oracle": "不得发生：未经确认直接进入写作",
      "condition": {
        "path": "observations.prematureWritingTransitionCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I03/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "I03.pass.01",
      "oracle": "入口为 refinement；交互一次只问一个关键问题",
      "condition": {
        "path": "observations.ideaMode",
        "operator": "eq",
        "expected": "refinement"
      },
      "evidenceRequired": [
        "results/I03/result.json"
      ]
    },
    {
      "id": "I03.pass.02",
      "oracle": "原始观测 maxQuestionsPerTurn 必须满足 lte 1",
      "condition": {
        "path": "observations.maxQuestionsPerTurn",
        "operator": "lte",
        "expected": 1
      },
      "evidenceRequired": [
        "results/I03/result.json"
      ]
    }
  ],
  "evidence": [
    "results/I03/result.json",
    "results/I03/artifacts/index.json"
  ],
  "sourceScenario": 3
}
