{
  "id": "I14",
  "criteriaDslVersion": 1,
  "title": "双安装一致且内部引用与旧流程有效",
  "mapsTo": [
    "WF12"
  ],
  "executionMode": "deterministic",
  "preconditions": [
    "隔离的 I14 测试项目已创建并保留输入快照"
  ],
  "inputs": [
    "两处授权安装根与受控 manifest"
  ],
  "actor": "CYZ scenario runner",
  "steps": [
    "比较受控文件 hash",
    "解析相对链接",
    "回归 PDF 与语言入口"
  ],
  "forbiddenBehavior": [
    {
      "id": "I14.forbid.01",
      "oracle": "不得发生：纳入 pycache 比较",
      "condition": {
        "path": "observations.includedPycacheCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I14/result.json"
      ]
    },
    {
      "id": "I14.forbid.02",
      "oracle": "不得发生：忽略断链或静默替代依赖",
      "condition": {
        "path": "observations.silentFallbackCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I14/result.json"
      ]
    }
  ],
  "passCriteria": [
    {
      "id": "I14.pass.01",
      "oracle": "两处受控树一致，链接与 PDF/语言回归通过",
      "condition": {
        "path": "observations.controlledTreeDifferenceCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I14/result.json"
      ]
    },
    {
      "id": "I14.pass.02",
      "oracle": "原始观测 brokenInternalLinkCount 必须满足 eq 0",
      "condition": {
        "path": "observations.brokenInternalLinkCount",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I14/result.json"
      ]
    },
    {
      "id": "I14.pass.03",
      "oracle": "原始观测 pdfRegressionExitCode 必须满足 eq 0",
      "condition": {
        "path": "observations.pdfRegressionExitCode",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I14/result.json"
      ]
    },
    {
      "id": "I14.pass.04",
      "oracle": "原始观测 languageRegressionExitCode 必须满足 eq 0",
      "condition": {
        "path": "observations.languageRegressionExitCode",
        "operator": "eq",
        "expected": 0
      },
      "evidenceRequired": [
        "results/I14/result.json"
      ]
    }
  ],
  "evidence": [
    "results/I14/result.json",
    "results/I14/artifacts/index.json"
  ],
  "sourceScenario": 14
}
